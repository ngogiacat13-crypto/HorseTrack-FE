{
  "name": "horse-track",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "json-server db.json --port 9999",
    "dev:all": "concurrently -k -n api,web -c blue,green \"npm:server\" \"npm:dev:server\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "dev:server": "vite --mode server",
    "dev:be": "vite --mode backend",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.scenarios.json",
    "scenarios": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run scenarios",
    "scenarios:live": "playwright test -c playwright.live.config.ts",
    "merge:main": "node scripts/merge-to-main.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "axios": "^1.7.7",
    "bootstrap": "^5.3.3",
    "formik": "^2.4.9",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.4",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.2",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.48.2",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "json-server": "^0.17.4",
    "prettier": "^3.9.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.3"
  }
}
