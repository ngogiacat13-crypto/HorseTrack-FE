{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "http://103.245.237.252:8080/api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
